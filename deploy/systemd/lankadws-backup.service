[Unit]
Description=LankaDWS encrypted backup
After=lankadws.service

[Service]
Type=oneshot
User=lankadws
Group=lankadws
WorkingDirectory=/opt/lankadws
ExecStart=/usr/bin/npm run backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lankadws /var/backups/lankadws
# npm writes its cache and logs under the user's home; keep it inside a writable path.
Environment=npm_config_cache=/var/lib/lankadws/.npm
UMask=0077
