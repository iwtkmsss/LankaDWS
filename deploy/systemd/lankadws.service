[Unit]
Description=LankaDWS API and worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust user and path to your install; the app reads ~/LankaDWS/.env itself.
User=root
WorkingDirectory=/root/LankaDWS/apps/api
ExecStart=/usr/bin/node dist/src/main.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
