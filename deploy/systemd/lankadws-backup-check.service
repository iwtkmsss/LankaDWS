[Unit]
Description=Check that the latest LankaDWS backup is recent

[Service]
Type=oneshot
User=lankadws
Group=lankadws
WorkingDirectory=/srv/lankadws/LankaDWS/apps/api
# Exits with an error when the newest backup is older than BACKUP_MAX_AGE_HOURS (default 2);
# `systemctl --failed` and the journal then show it. Hook OnFailure= to your alerting if you have one.
ExecStart=/usr/bin/node --import tsx scripts/backup-check.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
