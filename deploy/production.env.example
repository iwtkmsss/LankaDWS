# LankaDWS production configuration: copy to /srv/lankadws/LankaDWS/.env (see deploy/README.md).
# Change the domain; keep the /srv/lankadws paths unless you also change deploy/systemd/*.service.
# The secrets below are placeholders; `npm run lankadws -- recovery:hash` replaces them.
# Never commit the real .env.

# Runtime
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Your domain, https, no trailing slash.
FRONTEND_ORIGIN=https://lanka.example.com
FRONTEND_BASE_URL=https://lanka.example.com
# The API sits behind a reverse proxy (nginx) on the same host.
TRUSTED_PROXY=true

# SQLite and files: absolute paths on a local disk (never a network share; `~` does not work here).
DATABASE_URL=file:/srv/lankadws/data/db/lankadws.db
FILE_STORAGE_DIR=/srv/lankadws/data/files
FILE_QUARANTINE_DIR=/srv/lankadws/data/quarantine
FILE_TEMP_DIR=/srv/lankadws/data/tmp
BACKUP_DIR=/srv/lankadws/data/backups
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# `npm run backup:check` fails when the newest backup is older than this many hours.
BACKUP_MAX_AGE_HOURS=2
BACKUP_SCHEDULE_CRON=0 * * * *
RETENTION_SCHEDULE_CRON=15 2 * * *

# Secrets: placeholders are rejected when the app starts; `recovery:hash` fills them in.
SESSION_PEPPER=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
FILE_LINK_SECRET=replace-with-at-least-32-random-bytes
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters
BREAK_GLASS_SECRET_HASH=

# Sessions and security
SESSION_COOKIE_NAME=lankadws_session
SESSION_IDLE_MINUTES=60
TEMPORARY_PASSWORD_HOURS=24
REAUTH_MINUTES=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=8

# Files and jobs
MAX_UPLOAD_BYTES=104857600
ALLOWED_UPLOAD_MIME=application/pdf,application/msword,application/vnd.ms-excel,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.presentation,application/rtf,text/rtf,text/plain,text/csv,application/json,application/xml,image/png,image/jpeg,image/webp,image/gif,application/zip,application/x-rar-compressed,application/vnd.rar,application/x-7z-compressed,application/x-tar,application/gzip,application/x-bzip2,application/x-xz
# clamav = uploads are scanned (needs clamd on CLAMAV_HOST:CLAMAV_PORT, see deploy/README.md).
# unavailable = no scanner yet; uploads stay quarantined and cannot be downloaded.
MALWARE_SCANNER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCANNER_TIMEOUT_MS=30000
# Office preview: LibreOffice renders Word/Excel/PowerPoint as PDF (see deploy/README.md).
# Leave empty to turn the preview off; the files stay downloadable.
OFFICE_PREVIEW_SOFFICE=soffice
OFFICE_PREVIEW_TIMEOUT_MS=60000
JOB_CONCURRENCY=1
JOB_POLL_MS=1000
JOB_LEASE_SECONDS=60

# Logs and telemetry
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web build
VITE_API_BASE_URL=/api/v1
# Demo mode: false = real work (first admin via `npm run admin:create`).
# true = `npm run demo:seed` works and the login page shows the demo accounts and password.
# Rebuild after changing it.
VITE_DEMO_MODE=false
# Demo accounts' password, shown on the login page in demo mode; only needed when VITE_DEMO_MODE=true.
DEMO_SEED_PASSWORD=
