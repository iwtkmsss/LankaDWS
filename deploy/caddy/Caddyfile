# LankaDWS behind Caddy: automatic HTTPS (Let's Encrypt), static web build, API proxy.
# Replace portal.example.com with your domain; its DNS A/AAAA record must point to this server,
# and ports 80 and 443 must be open.

portal.example.com {
	encode zstd gzip

	# API and its server-sent events (chat realtime). flush_interval -1 disables buffering for SSE.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /opt/lankadws/apps/web/dist

		# Hashed build output never changes; public files in /assets (avatars, patterns) are revalidated.
		@hashed path_regexp ^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css|woff2?)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header -Server

		# Single-page app: unknown paths render index.html, the client router decides.
		try_files {path} /index.html
		file_server
	}

	# Uploads up to MAX_UPLOAD_BYTES (100 MB) plus multipart overhead.
	request_body {
		max_size 110MB
	}

	log {
		output file /var/log/caddy/lankadws.log
	}
}
