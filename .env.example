# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
TRUSTED_PROXY=false

# SQLite and files (production paths must be local persistent volumes)
DATABASE_URL=file:./prisma/dev.db
FILE_STORAGE_DIR=../../data/files
FILE_QUARANTINE_DIR=../../data/quarantine
FILE_TEMP_DIR=../../data/tmp
BACKUP_DIR=../../backups
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_SCHEDULE_CRON=0 * * * *
RETENTION_SCHEDULE_CRON=15 2 * * *

# Bitrix migration package (absolute paths outside this repository)
BITRIX_SNAPSHOT_ROOT=
# Exporter-side seal request and Ed25519 private key; only required by import:seal-manifest.
BITRIX_MANIFEST_METADATA_PATH=
IMPORT_SIGNING_PRIVATE_KEY_PATH=
# JSON object: {"key-id":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
IMPORT_SIGNING_PUBLIC_KEYS_JSON={}

# Secrets: run `npm run lankadws -- recovery:hash` to generate independent CSPRNG values
SESSION_PEPPER=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-at-least-32-random-bytes
TOTP_ENCRYPTION_KEY=replace-with-64-hex-characters
FILE_LINK_SECRET=replace-with-at-least-32-random-bytes
BACKUP_ENCRYPTION_KEY=replace-with-64-hex-characters
BREAK_GLASS_SECRET_HASH=

# Sessions and security
SESSION_COOKIE_NAME=lankadws_session
SESSION_IDLE_MINUTES=60
TEMPORARY_PASSWORD_HOURS=24
REAUTH_MINUTES=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX=8

# Files and jobs
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/png,image/jpeg,image/webp,text/plain
MALWARE_SCANNER=development-clean
JOB_CONCURRENCY=1
JOB_POLL_MS=1000
JOB_LEASE_SECONDS=60

# Optional telemetry / mail adapters
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_EXPORTER_OTLP_ENDPOINT=
EMAIL_ADAPTER=disabled

# Development-only deterministic seed. Never set this in production.
DEMO_SEED_PASSWORD=LankaDWSDemoPassphrase2026!
VITE_API_BASE_URL=/api/v1
VITE_DEMO_MODE=true
