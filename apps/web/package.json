{
  "name": "@bert-crm/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "typecheck": "npm run build --workspace @bert-crm/contracts && tsc -b --pretty false",
    "test": "vitest run",
    "pretest:e2e": "npm run build --prefix ../../packages/contracts && npm run build --prefix ../api",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bert-crm/contracts": "*",
    "@fontsource-variable/onest": "^5.2.8",
    "@tanstack/react-query": "^5.90.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^27.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  }
}
