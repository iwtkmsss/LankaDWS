  userId                  String
  deliveredAt             DateTime     @default(now())
  readAt                  DateTime?
  dismissedAt             DateTime?
  effectiveContentVersion Int
  announcement            Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt, deliveredAt])
}

model Notification {
  id             String    @id
  recipientId    String
  category       String
  safeTitle      String
  safeSnippet    String
  entityType     String
  entityId       String
  requiresAction Boolean   @default(false)
  readAt         DateTime?
  deliveredAt    DateTime?
  dedupeKey      String    @unique
  createdAt      DateTime  @default(now())

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, requiresAction, createdAt])
}

model NotificationPreference {
  id        String  @id
  userId    String
  category  String
  channel   String
  enabled   Boolean @default(true)
  digest    String  @default("IMMEDIATE")
  quietJson String  @default("{}")
  version   Int     @default(1)

  @@unique([userId, category, channel])
}

model MessageThread {
  id            String              @id
  workspaceId   String
  companyId     String?
  kind          String
  title         String?
  entityType    String?
  entityId      String?
  directKey     String?             @unique
  createdById   String?
  lastMessageAt DateTime?
  version       Int                 @default(1)
  createdAt     DateTime            @default(now())
  participants  ThreadParticipant[]
  messages      Message[]

  @@index([companyId, lastMessageAt])
  @@index([workspaceId, companyId, kind])
  @@index([workspaceId, companyId, lastMessageAt, createdAt, id])
}

model ThreadParticipant {
  id                String        @id
  threadId          String
  userId            String
  role              String
  notificationMode  String        @default("ALL")
  joinedAt          DateTime      @default(now())
  leftAt            DateTime?
  lastReadMessageId String?
  version           Int           @default(1)
  thread            MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, leftAt])
  @@index([threadId, leftAt, notificationMode])
}

model Message {
  id        String        @id
  threadId  String
  authorId  String
  body      String
  replyToId String?
  createdAt DateTime      @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  version   Int           @default(1)
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt, id])
  @@index([threadId, deletedAt, createdAt, id])
}

model Comment {
  id               String    @id
  workspaceId      String
  companyId        String
  entityType       String
  entityId         String
  authorId         String
  body             String
  visibility       String
  replyToCommentId String?
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?
  version          Int       @default(1)

  @@index([entityType, entityId, createdAt])
  @@index([replyToCommentId])
}

model SavedView {
  id         String   @id
  userId     String
  module     String
  name       String
  queryState String
  isDefault  Boolean  @default(false)
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([userId, module, name])
}

model UserUiPreference {
  id            String   @id
  userId        String
  module        String
  key           String
  schemaVersion Int
  valueJson     String
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, key])
  @@index([userId, updatedAt])
}

model AuditEvent {
  id            String   @id
  workspaceId   String
  companyId     String?
  actorType     String
  actorId       String?
  action        String
  entityType    String
  entityId      String
  result        String
  risk          String
  safeDiffJson  String   @default("{}")
  reasonCode    String?
  correlationId String
  createdAt     DateTime @default(now())

  @@index([workspaceId, createdAt, id])
  @@index([companyId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model OutboxEvent {
  id               String      @id
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  eventType        String
  safePayload      String
  state            OutboxState @default(PENDING)
  attempts         Int         @default(0)
  nextRunAt        DateTime    @default(now())
  createdAt        DateTime    @default(now())
  processedAt      DateTime?

  @@unique([aggregateType, aggregateId, aggregateVersion, eventType])
  @@index([state, nextRunAt])
}

model BackgroundJob {
  id             String    @id
  type           String
  entityType     String
  entityId       String
  state          JobState  @default(QUEUED)
  safePayload    String
  progress       Int       @default(0)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  runAt          DateTime  @default(now())
  leaseOwner     String?
  leaseUntil     DateTime?
  lastErrorCode  String?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, runAt, id])
  @@index([leaseUntil])
}

model RetentionPolicy {
  id           String   @id
  category     String
  durationDays Int
  action       String
  version      Int
  effectiveAt  DateTime
  changedBy    String
  createdAt    DateTime @default(now())

  @@unique([category, version])
  @@index([effectiveAt])
}

model SystemSetting {
  id          String   @id
  key         String
  valueJson   String
  version     Int      @default(1)
  effectiveAt DateTime @default(now())
  updatedBy   String
  updatedAt   DateTime @updatedAt

  @@unique([key, version])
  @@index([key, effectiveAt])
}

model LegalHold {
  id         String    @id
  entityType String
  entityId   String
  reason     String
  placedBy   String
  placedAt   DateTime  @default(now())
  releasedBy String?
  releasedAt DateTime?
  status     String

  @@index([entityType, entityId, status])
}

model IdempotencyRecord {
  id                 String   @id
  userId             String
  key                String
  operation          String
  requestFingerprint String
  resultType         String?
  resultId           String?
  responseStatus     Int?
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@unique([userId, key, operation])
  @@index([expiresAt])
}
