generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AccountType {
  ADMIN
  USER
}

enum TaskStatus {
  NEW
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskParticipantRole {
  RESPONSIBLE
  COLLABORATOR
  WATCHER
}

enum TaskReminderStatus {
  ACTIVE
  SENT
  CANCELLED
}

enum TaskRelationType {
  RELATED
  BLOCKS
  DUPLICATES
}

enum TaskReminderTriggerType {
  AT
  BEFORE_START
  BEFORE_DUE
}

enum TaskReminderChannel {
  IN_APP
}

enum TaskRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ExecutionStatus {
  NOT_STARTED
  QUEUED
  RUNNING
  SUCCEEDED
  PARTIAL_FAILURE
  FAILED
}

enum Confidentiality {
  GENERAL
  INTERNAL
  CONFIDENTIAL
  HR_SECURITY
}

enum JobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum FileScanStatus {
  QUARANTINED
  SCANNING
  CLEAN
  INFECTED
  UNSUPPORTED
  FAILED
}

enum OutboxState {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum GroupDiscoverability {
  LISTED
  HIDDEN
}

enum GroupJoinPolicy {
  OPEN
  REQUEST
  INVITE_ONLY
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum GroupMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum GroupJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum GroupNotificationMode {
  ALL
  MENTIONS
  NONE
}

enum FeedPostStatus {
  PUBLISHED
  ARCHIVED
}

enum FeedRecipientType {
  COMPANY
  GROUP
  USER
}

enum FeedFileShareStatus {
  ACTIVE
  REVOKED
}

enum FeedReactionKind {
  LIKE
}

enum ImportDatasetKind {
  SNAPSHOT
  DELTA
}

enum ImportDatasetStatus {
  INGESTING
  SEALED
  INVALID
}

enum ImportFileStatus {
  PENDING
  VERIFIED
  INVALID
}

enum ImportRunMode {
  VALIDATE
  DRY_RUN
  APPLY
}

enum ImportRunStatus {
  QUEUED
  RUNNING
  PAUSED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ImportReconciliationStatus {
  NOT_RUN
  PASSED
  FAILED
}

enum ImportIssueSeverity {
  WARNING
  BLOCKING
}

enum ImportChangeOperation {
  CREATE
  UPDATE
  NOOP
  TOMBSTONE
  QUARANTINE
}

enum ImportBinaryTransferStatus {
  PENDING
  UPLOADING
  UPLOADED
  SCANNING
  CLEAN
  PROMOTED
  FAILED
}

enum MigrationActivationStatus {
  PREPARING
  READY
  ACTIVE_PRE_WRITE
  FORWARD_FIX_ONLY
  ROLLED_BACK
}

enum SourceCompanyMappingStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model Workspace {
  id                    String                 @id
  displayName           String
  status                RecordStatus           @default(ACTIVE)
  defaultTimezone       String                 @default("Europe/Kyiv")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  companies             Company[]
  users                 User[]
  groups                Group[]
  projects              Project[]
  tags                  Tag[]
  orgUnits              OrgUnit[]
  feedPosts             FeedPost[]
  feedItems             FeedItem[]
  feedSourceHeads       FeedSourceHead[]
  feedFileShares        FeedFileShare[]
  importDatasets        ImportDataset[]
  importApplyLeases     ImportApplyLease[]
  externalIdMaps        ExternalIdMap[]
  sourceCompanyMappings SourceCompanyMapping[]
  migrationActivations  MigrationActivation[]

  @@index([status])
}

model Company {
  id                    String                 @id
  workspaceId           String
  displayName           String
  legalName             String
  code                  String
  isActive              Boolean                @default(true)
  timezone              String                 @default("Europe/Kyiv")
  locale                String                 @default("uk-UA")
  workingDaysJson       String                 @default("[1,2,3,4,5]")
  holidayJson           String                 @default("[]")
  version               Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  workspace             Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  primaryUsers          User[]                 @relation("PrimaryCompany")
  capabilities          CompanyCapability[]
  groups                Group[]
  projects              Project[]
  tags                  Tag[]
  orgUnits              OrgUnit[]
  orgAssignments        UserOrgAssignment[]
  feedPosts             FeedPost[]
  feedItems             FeedItem[]
  feedSourceHeads       FeedSourceHead[]
  feedFileShares        FeedFileShare[]
  feedReadCursors       FeedReadCursor[]
  sourceCompanyMappings SourceCompanyMapping[]
  migrationActivations  MigrationActivation[]

  @@unique([workspaceId, code])
  @@index([workspaceId, isActive])
}

enum TaskApprovalStatus {
  PENDING
  APPROVED
  NEEDS_CHANGES
  INVALIDATED
}

model User {
  id                           String                         @id
  workspaceId                  String
  primaryCompanyId             String?
  accountType                  AccountType                    @default(USER)
  firstName                    String                         @default("")
  lastName                     String                         @default("")
  middleName                   String?
  phone                        String?
  gender                       String?
  birthDate                    DateTime?
  displayName                  String
  normalizedDisplayName        String
  username                     String
  normalizedUsername           String
  contactEmail                 String?
  jobTitle                     String                         @default("")
  approverId                   String?
  timezone                     String                         @default("Europe/Kyiv")
  locale                       String                         @default("uk-UA")
  isActive                     Boolean                        @default(true)
  mustEnroll2FA                Boolean                        @default(false)
  authorizationVersion         Int                            @default(1)
  avatarAsset                  String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  workspace                    Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  primaryCompany               Company?                       @relation("PrimaryCompany", fields: [primaryCompanyId], references: [id], onDelete: Restrict)
  approver                     User?                          @relation("UserApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approverFor                  User[]                         @relation("UserApprover")
  passwordCredential           PasswordCredential?
  totpCredential               TotpCredential?
  recoveryCodes                RecoveryCode[]
  sessions                     UserSession[]
  enabledCapabilities          CompanyCapability[]            @relation("CapabilityEnabler")
  ownedGroups                  Group[]                        @relation("GroupOwner")
  groupMemberships             GroupMember[]
  requestedGroupJoins          GroupJoinRequest[]             @relation("GroupJoinRequester")
  decidedGroupJoins            GroupJoinRequest[]             @relation("GroupJoinDecider")
  authoredFeedPosts            FeedPost[]                     @relation("FeedPostAuthor")
  feedItems                    FeedItem[]                     @relation("FeedItemActor")
  ownedFeedFileShares          FeedFileShare[]                @relation("FeedFileShareOwner")
  feedFileShareRecipients      FeedFileShareRecipient[]       @relation("FeedFileShareRecipientUser")
  feedItemRecipients           FeedItemRecipient[]            @relation("FeedItemRecipientUser")
  feedAckRecipients            FeedAcknowledgementRecipient[] @relation("FeedAckRecipientUser")
  feedAcknowledgements         FeedPostAcknowledgement[]      @relation("FeedAcknowledgementUser")
  feedReactions                FeedReaction[]                 @relation("FeedReactionUser")
  feedSubscriptions            FeedSubscription[]             @relation("FeedSubscriptionUser")
  feedMentions                 FeedMention[]                  @relation("FeedMentionUser")
  feedReadCursors              FeedReadCursor[]               @relation("FeedReadCursorUser")
  feedItemStates               FeedUserItemState[]            @relation("FeedUserItemStateUser")
  managedOrgUnits              OrgUnit[]                      @relation("OrgUnitManager")
  orgAssignments               UserOrgAssignment[]
  createdSourceCompanyMappings SourceCompanyMapping[]         @relation("SourceCompanyMappingCreator")
  activatedMigrations          MigrationActivation[]          @relation("MigrationActivator")
  taskParticipations           TaskParticipant[]              @relation("TaskParticipantUser")
  taskParticipantsAdded        TaskParticipant[]              @relation("TaskParticipantAdder")
  tasksCreated                 Task[]                         @relation("TaskCreatedBy")
  tasksReported                Task[]                         @relation("TaskReporter")
  taskRelationsCreated         TaskRelation[]                 @relation("TaskRelationCreator")
  taskTimeEntries              TimeEntry[]
  taskFollowers                TaskFollower[]
  taskStates                   TaskUserState[]
  taskReminders                TaskReminder[]
  taskApprovalRequests         TaskApprovalRound[]            @relation("TaskApprovalRequester")
  taskApprovalsAssigned        TaskApprovalRound[]            @relation("TaskApprovalApprover")
  taskApprovalInvalidations    TaskApprovalRound[]            @relation("TaskApprovalInvalidator")
  uiPreferences                UserUiPreference[]

  @@unique([workspaceId, normalizedUsername])
  @@index([workspaceId, isActive])
  @@index([workspaceId, isActive, normalizedUsername, id])
  @@index([workspaceId, isActive, normalizedDisplayName, id])
  @@index([primaryCompanyId, isActive])
  @@index([approverId])
}

model UsernameReservation {
  id                 String   @id
  workspaceId        String
  normalizedUsername String
  currentUserId      String?
  previousUserId     String?
  state              String
  reservedAt         DateTime @default(now())

  @@unique([workspaceId, normalizedUsername])
}

model CompanyCapability {
  id          String    @id
  companyId   String
  code        String
  enabled     Boolean   @default(false)
  enabledById String?
  enabledAt   DateTime?
  disabledAt  DateTime?
  version     Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabledBy   User?     @relation("CapabilityEnabler", fields: [enabledById], references: [id], onDelete: SetNull)

  @@unique([companyId, code])
  @@index([code, enabled, companyId])
  @@index([enabledById])
}

model Group {
  id              String               @id
  workspaceId     String
  companyId       String
  key             String
  name            String
  description     String?
  discoverability GroupDiscoverability @default(LISTED)
  joinPolicy      GroupJoinPolicy      @default(REQUEST)
  status          GroupStatus          @default(ACTIVE)
  ownerId         String
  version         Int                  @default(1)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  archivedAt      DateTime?
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  company         Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  owner           User                 @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members         GroupMember[]
  joinRequests    GroupJoinRequest[]
  feedPosts       FeedPost[]
  feedFileShares  FeedFileShare[]
  tasks           Task[]

  @@unique([companyId, key])
  @@index([workspaceId, companyId, status])
  @@index([companyId, discoverability, status, updatedAt])
  @@index([ownerId, status])
}

model GroupMember {
  id               String                @id
  groupId          String
  userId           String
  role             GroupMemberRole       @default(MEMBER)
  notificationMode GroupNotificationMode @default(ALL)
  joinedAt         DateTime              @default(now())
  leftAt           DateTime?
  lastSeenAt       DateTime?
  version          Int                   @default(1)
  group            Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId, leftAt])
  @@index([groupId, role, leftAt])
}

model GroupJoinRequest {
  id          String                 @id
  groupId     String
  requesterId String
  status      GroupJoinRequestStatus @default(PENDING)
  activeKey   String?                @unique
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  version     Int                    @default(1)
  group       Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester   User                   @relation("GroupJoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  decidedBy   User?                  @relation("GroupJoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([groupId, status, createdAt])
  @@index([requesterId, status])
  @@index([decidedById])
}

model FeedPost {
  id                        String                         @id
  workspaceId               String
  companyId                 String
  groupId                   String?
  authorId                  String
  body                      String
  status                    FeedPostStatus                 @default(PUBLISHED)
  requiresAcknowledgement   Boolean                        @default(false)
  acknowledgementVersion    Int                            @default(0)
  version                   Int                            @default(1)
  publishedAt               DateTime                       @default(now())
  editedAt                  DateTime?
  archivedAt                DateTime?
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt
  workspace                 Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  company                   Company                        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  group                     Group?                         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  author                    User                           @relation("FeedPostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  recipients                FeedPostRecipient[]
  acknowledgementRecipients FeedAcknowledgementRecipient[]
  acknowledgements          FeedPostAcknowledgement[]
  items                     FeedItem[]
  reactions                 FeedReaction[]
  subscriptions             FeedSubscription[]
  mentions                  FeedMention[]

  @@index([workspaceId, companyId, status, publishedAt, id])
  @@index([authorId, status, publishedAt])
  @@index([groupId, status, publishedAt])
}

model FeedPostRecipient {
  id          String            @id
  postId      String
  type        FeedRecipientType
  recipientId String
  createdAt   DateTime          @default(now())
  post        FeedPost          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, type, recipientId])
  @@index([type, recipientId, postId])
}

model FeedAcknowledgementRecipient {
  id                     String   @id
  postId                 String
  userId                 String
  acknowledgementVersion Int
  createdAt              DateTime @default(now())
  post                   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user                   User     @relation("FeedAckRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, acknowledgementVersion])
  @@index([userId, acknowledgementVersion, postId])
}

model FeedPostAcknowledgement {
  id                     String   @id
  postId                 String
  userId                 String
  acknowledgementVersion Int
  acknowledgedAt         DateTime @default(now())
  post                   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user                   User     @relation("FeedAcknowledgementUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, acknowledgementVersion])
  @@index([userId, acknowledgedAt])
}

model FeedItem {
  id             String              @id
  workspaceId    String
  companyId      String
  postId         String?
  fileShareId    String?
  sourceType     String
  sourceId       String
  sourceVersion  Int
  action         String
  eventKey       String              @unique
  actorId        String?
  visibility     String
  safePayload    String
  countsAsUnread Boolean             @default(true)
  occurredAt     DateTime
  createdAt      DateTime            @default(now())
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  post           FeedPost?           @relation(fields: [postId], references: [id], onDelete: Cascade)
  fileShare      FeedFileShare?      @relation(fields: [fileShareId], references: [id], onDelete: Restrict)
  actor          User?               @relation("FeedItemActor", fields: [actorId], references: [id], onDelete: SetNull)
  recipients     FeedItemRecipient[]
  userStates     FeedUserItemState[]
  sourceHead     FeedSourceHead?     @relation("FeedSourceHeadItem")

  @@index([workspaceId, companyId, occurredAt, id])
  @@index([postId, sourceVersion])
  @@index([fileShareId, sourceVersion])
  @@index([sourceType, sourceId, sourceVersion])
}

model FeedSourceHead {
  id             String    @id
  workspaceId    String
  companyId      String
  sourceType     String
  sourceId       String
  itemId         String    @unique
  sourceVersion  Int
  countsAsUnread Boolean   @default(true)
  occurredAt     DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  item           FeedItem  @relation("FeedSourceHeadItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, companyId, sourceType, sourceId])
  @@index([workspaceId, companyId, occurredAt, itemId])
  @@index([workspaceId, companyId, countsAsUnread, occurredAt, itemId])
}

model FeedFileShare {
  id               String                   @id
  workspaceId      String
  companyId        String
  fileId           String
  ownerId          String
  audienceType     FeedRecipientType
  audienceKey      String
  groupId          String?
  status           FeedFileShareStatus      @default(ACTIVE)
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  revokedAt        DateTime?
  workspace        Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  company          Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  file             FileObject               @relation(fields: [fileId], references: [id], onDelete: Restrict)
  owner            User                     @relation("FeedFileShareOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  group            Group?                   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  directRecipients FeedFileShareRecipient[]
  items            FeedItem[]

  @@index([workspaceId, companyId, status, createdAt])
  @@index([fileId, status, createdAt])
  @@index([ownerId, status, createdAt])
  @@index([groupId, status])
}

model FeedFileShareRecipient {
  id        String        @id
  shareId   String
  userId    String
  createdAt DateTime      @default(now())
  share     FeedFileShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user      User          @relation("FeedFileShareRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shareId, userId])
  @@index([userId, shareId])
}

model FeedUserItemState {
  id          String    @id
  userId      String
  feedItemId  String
  favoritedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("FeedUserItemStateUser", fields: [userId], references: [id], onDelete: Cascade)
  feedItem    FeedItem  @relation(fields: [feedItemId], references: [id], onDelete: Cascade)

  @@unique([userId, feedItemId])
  @@index([userId, favoritedAt])
  @@index([feedItemId])
}

model FeedItemRecipient {
  id        String   @id
  itemId    String
  userId    String
  createdAt DateTime @default(now())
  item      FeedItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user      User     @relation("FeedItemRecipientUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
  @@index([userId, itemId])
}

model FeedReadCursor {
  id                 String   @id
  userId             String
  companyId          String
  lastReadOccurredAt DateTime
  lastReadItemId     String
  updatedAt          DateTime @updatedAt
  user               User     @relation("FeedReadCursorUser", fields: [userId], references: [id], onDelete: Cascade)
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId, lastReadOccurredAt, lastReadItemId])
}

model FeedReaction {
  id        String           @id
  postId    String
  userId    String
  kind      FeedReactionKind @default(LIKE)
  createdAt DateTime         @default(now())
  post      FeedPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation("FeedReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, kind])
  @@index([userId, createdAt])
}

model FeedSubscription {
  id        String   @id
  postId    String
  userId    String
  mode      String   @default("ALL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("FeedSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, mode])
}

model FeedMention {
  id        String   @id
  postId    String
  commentId String?
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation("FeedMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, commentId, userId])
  @@index([userId, createdAt])
}

model ContentMention {
  id          String   @id
  workspaceId String
  sourceType  String
  sourceId    String
  userId      String
  start       Int
  end         Int
  label       String
  createdAt   DateTime @default(now())

  @@unique([sourceType, sourceId, start])
  @@index([workspaceId, sourceType, sourceId, start])
  @@index([userId, createdAt])
}

model OrgUnit {
  id             String              @id
  workspaceId    String
  companyId      String
  sourceKey      String?
  parentId       String?
  name           String
  normalizedName String
  managerId      String?
  status         RecordStatus        @default(ACTIVE)
  sortOrder      Int                 @default(0)
  version        Int                 @default(1)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent         OrgUnit?            @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       OrgUnit[]           @relation("OrgUnitTree")
  manager        User?               @relation("OrgUnitManager", fields: [managerId], references: [id], onDelete: SetNull)
  assignments    UserOrgAssignment[]

  @@unique([companyId, sourceKey])
  @@index([companyId, parentId, status, sortOrder])
  @@index([companyId, normalizedName, status])
  @@index([managerId])
}

model UserOrgAssignment {
  id            String    @id
  companyId     String
  userId        String
  orgUnitId     String
  isPrimary     Boolean   @default(false)
  positionTitle String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgUnit       OrgUnit   @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@unique([userId, orgUnitId, startedAt])
  @@index([orgUnitId, endedAt, isPrimary])
  @@index([companyId, userId, endedAt])
}

model SourceCompanyMapping {
  id               String                     @id
  workspaceId      String
  sourceSystem     String
  sourceTenantId   String
  version          Int
  sourceOrgUnitKey String
  targetCompanyId  String
  status           SourceCompanyMappingStatus @default(DRAFT)
  createdById      String
  createdAt        DateTime                   @default(now())
  activatedAt      DateTime?
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  targetCompany    Company                    @relation(fields: [targetCompanyId], references: [id], onDelete: Restrict)
  createdBy        User                       @relation("SourceCompanyMappingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([workspaceId, sourceSystem, sourceTenantId, version, sourceOrgUnitKey])
  @@index([workspaceId, sourceSystem, sourceTenantId, version, status])
  @@index([targetCompanyId, status])
}

model ImportDataset {
  id                      String                 @id
  workspaceId             String
  sourceSystem            String
  sourceTenantId          String
  sourceBuild             String
  sourceSchemaFingerprint String
  companyMappingVersion   Int
  kind                    ImportDatasetKind
  parentDatasetId         String?
  sequence                Int
  exportedAt              DateTime
  watermarkFromJson       String?
  watermarkToJson         String
  mappingVersion          Int
  schemaVersion           Int
  manifestSha256          String
  encryptionKeyId         String
  status                  ImportDatasetStatus    @default(INGESTING)
  createdAt               DateTime               @default(now())
  sealedAt                DateTime?
  workspace               Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  parentDataset           ImportDataset?         @relation("ImportDatasetChain", fields: [parentDatasetId], references: [id], onDelete: Restrict)
  childDatasets           ImportDataset[]        @relation("ImportDatasetChain")
  files                   ImportFile[]
  runs                    ImportRun[]
  binaryTransfers         ImportBinaryTransfer[]
  externalMaps            ExternalIdMap[]
  finalActivations        MigrationActivation[]  @relation("MigrationFinalDataset")

  @@unique([workspaceId, sourceSystem, sourceTenantId, sequence])
