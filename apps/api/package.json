{
  "name": "@lankadws/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "dev:public": "nest start --watch",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "npm run build --workspace @lankadws/contracts && prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/** --exclude test/integration/** --exclude test/e2e/**",
    "pretest:integration": "prisma generate",
    "test:integration": "vitest run test/integration",
    "pretest:e2e": "prisma generate",
    "test:e2e": "vitest run test/e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "lankadws": "tsx src/cli/main.ts",
    "web-e2e:prepare": "tsx scripts/prepare-web-e2e.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:verify": "tsx scripts/restore-verify.ts",
    "openapi": "tsx scripts/generate-openapi.ts",
    "feed:rehearse": "tsx scripts/feed-rehearsal.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@lankadws/contracts": "*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.8.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "otpauth": "^9.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.0.18"
  }
}
